        "scoring_manifest_sha256",
        "sealed_mapping_sha256",
        "final_test_class_counts_published",
        "raw_data_in_git"
      ],
      "field_types": {
        "contract_version": "string",
        "run_id": "string",
        "run_kind": "string",
        "preregistration_commit": "commit",
        "preregistration_document_sha256": "sha256",
        "archive_sha256": "sha256",
        "split_sha256": "sha256",
        "reference_count": "integer",
