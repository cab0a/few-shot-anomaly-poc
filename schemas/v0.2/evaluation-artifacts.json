{
  "contract_version": "evaluation-artifacts/v0.2",
  "status": "frozen_before_boundary_preparation",
  "artifact_root_template": "artifacts/v0.2/evaluation/{run_id}",
  "run_id_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
  "allowed_run_kinds": [
    "synthetic",
    "final_test"
  ],
  "allowed_methods": [
    "ecc_residual",
    "patch_hog_ocsvm",
    "dinov2_vits14_224_nn"
  ],
  "serialization": {
    "text_encoding": "UTF-8",
    "line_ending": "LF",
    "final_newline": true,
    "json": {
      "indent": 2,
      "sort_keys": true,
      "ensure_ascii": false,
      "allow_nan": false
    },
    "csv": {
      "dialect": "RFC 4180",
      "delimiter": ",",
      "header": true,
      "quoting": "minimal",
      "null": "",
      "boolean_true": "true",
      "boolean_false": "false",
      "finite_float": "CPython 3.13 shortest round-trip decimal"
    }
  },
  "common_rules": {
    "relative_paths_only": true,
    "absolute_paths_forbidden": true,
    "timestamps_forbidden": true,
    "non_finite_numbers_forbidden": true,
    "duplicate_primary_keys_forbidden": true,
    "row_order_must_match_sort_key": true,
    "overwrite_forbidden": true,
    "raw_dataset_content_forbidden": true,
    "source_or_model_assets_forbidden": true
  },
  "final_test_label_free_contracts": [
    "score",
    "classification",
    "latency_observation",
    "reproduction"
  ],
  "final_test_label_free_forbidden_fields": [
    "true_class",
    "class_label",
    "source_path",
    "official_split",
    "sealed_mapping",
    "hmac_key"
  ],
  "method_score_rules": {
    "ecc_residual": {
      "success_minimum": 0.0,
      "success_minimum_inclusive": true,
      "success_maximum": 1.0,
      "success_maximum_inclusive": true,
      "failure_score": 1.0
    },
    "patch_hog_ocsvm": {
      "success_minimum": -1000000000000.0,
      "success_minimum_inclusive": false,
      "success_maximum": 1000000000000.0,
      "success_maximum_inclusive": false,
      "failure_score": 1000000000000.0
    },
    "dinov2_vits14_224_nn": {
      "success_minimum": 0.0,
      "success_minimum_inclusive": true,
      "success_maximum": 2.0,
      "success_maximum_inclusive": true,
      "failure_score": 2.0
    }
  },
  "contracts": {
    "boundary_record": {
      "format": "json",
      "label_boundary": "sealed",
      "path_template": "boundary/boundary-record.json",
