{
  "contract_version": "evaluation-artifacts/v0.1",
  "status": "frozen_before_final_test",
  "artifact_root_template": "artifacts/v0.1/evaluation/{run_id}",
  "run_id_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
  "allowed_run_kinds": [
    "synthetic",
    "final_test"
  ],
  "allowed_methods": [
    "ecc_residual",
    "patch_hog_one_class_svm"
  ],
  "serialization": {
    "text_encoding": "UTF-8",
    "line_ending": "LF",
    "final_newline": true,
    "json": {
      "indent": 2,
      "sort_keys": true,
      "ensure_ascii": false,
      "allow_nan": false
    },
    "csv": {
      "dialect": "RFC 4180",
      "delimiter": ",",
      "header": true,
      "quoting": "minimal",
      "null": "",
      "boolean_true": "true",
      "boolean_false": "false",
      "finite_float": "CPython 3.13 shortest round-trip decimal"
    }
  },
  "common_rules": {
    "relative_paths_only": true,
    "absolute_paths_forbidden": true,
    "timestamps_forbidden": true,
    "non_finite_numbers_forbidden": true,
    "row_order_must_match_sort_key": true,
    "duplicate_primary_keys_forbidden": true,
    "overwrite_forbidden": true,
    "raw_dataset_content_forbidden": true
  },
  "contracts": {
    "score": {
      "format": "csv",
      "path_template": "{method}/scores.csv",
      "primary_key": [
        "run_id",
        "method",
        "partition",
        "relative_path"
      ],
      "sort_key": [
        "method",
        "partition_fixed_calibration_first",
        "relative_path"
      ],
      "columns": [
        {
          "name": "contract_version",
          "type": "string",
          "nullable": false,
          "fixed": "evaluation-artifacts/v0.1"
        },
        {
          "name": "run_id",
          "type": "string",
          "nullable": false
        },
        {
          "name": "run_kind",
          "type": "string",
          "nullable": false,
          "enum": [
            "synthetic",
            "final_test"
          ]
        },
        {
          "name": "method",
          "type": "string",
          "nullable": false,
          "enum": [
            "ecc_residual",
            "patch_hog_one_class_svm"
          ]
        },
        {
          "name": "partition",
          "type": "string",
          "nullable": false,
          "enum": [
            "calibration",
            "final_test"
          ]
        },
        {
          "name": "relative_path",
          "type": "relative_path",
          "nullable": false
        },
        {
          "name": "score_status",
          "type": "string",
          "nullable": false,
          "enum": [
            "ok",
            "failed"
          ]
        },
        {
          "name": "score_failure_code",
          "type": "string",
          "nullable": true
        },
        {
          "name": "anomaly_score",
          "type": "number",
          "nullable": false
        },
        {
          "name": "diagnostics_json",
          "type": "canonical_json_object",
          "nullable": false
        }
      ]
    },
    "classification": {
      "format": "csv",
      "path_template": "{method}/classifications.csv",
      "primary_key": [
        "run_id",
        "method",
        "relative_path"
      ],
      "sort_key": [
        "method",
        "relative_path"
      ],
      "columns": [
        {
          "name": "contract_version",
          "type": "string",
          "nullable": false,
          "fixed": "evaluation-artifacts/v0.1"
        },
        {
          "name": "run_id",
          "type": "string",
          "nullable": false
        },
        {
          "name": "run_kind",
          "type": "string",
          "nullable": false,
          "enum": [
            "synthetic",
            "final_test"
          ]
        },
        {
          "name": "method",
          "type": "string",
          "nullable": false
        },
        {
          "name": "relative_path",
          "type": "relative_path",
          "nullable": false
        },
        {
          "name": "score_status",
          "type": "string",
          "nullable": false
        },
        {
          "name": "score_failure_code",
          "type": "string",
          "nullable": true
        },
        {
          "name": "anomaly_score",
          "type": "number",
          "nullable": false
        },
        {
          "name": "threshold",
          "type": "number",
          "nullable": false
        },
        {
          "name": "threshold_source_path",
          "type": "relative_path",
          "nullable": false
        },
        {
          "name": "calibration_sample_count",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "calibration_rank",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "predicted_class",
          "type": "string",
          "nullable": false,
          "enum": [
            "normal",
            "anomalous"
          ]
        },
        {
          "name": "is_anomalous",
          "type": "boolean",
          "nullable": false
        },
        {
          "name": "decision_reason",
          "type": "string",
          "nullable": false
        },
        {
          "name": "score_margin",
          "type": "number",
          "nullable": false
        }
      ]
    },
    "label_reveal": {
      "format": "csv",
      "path_template": "{method}/revealed-labels.csv",
      "primary_key": [
        "run_id",
        "method",
        "relative_path"
      ],
      "sort_key": [
        "method",
        "relative_path"
      ],
      "columns": [
        {
          "name": "contract_version",
          "type": "string",
          "nullable": false,
          "fixed": "evaluation-artifacts/v0.1"
        },
        {
          "name": "run_id",
          "type": "string",
