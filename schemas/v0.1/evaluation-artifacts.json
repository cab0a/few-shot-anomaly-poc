        },
        {
          "name": "run_kind",
          "type": "string",
          "nullable": false
        },
        {
          "name": "method",
          "type": "string",
          "nullable": false
        },
        {
          "name": "relative_path",
          "type": "relative_path",
          "nullable": false
        },
        {
          "name": "true_class",
          "type": "string",
          "nullable": false,
          "enum": [
            "normal",
            "anomaly"
          ]
        }
      ]
    },
    "metrics": {
      "format": "json",
      "path_template": "{method}/metrics.json",
      "required_keys": [
        "contract_version",
        "run_id",
        "run_kind",
        "method",
        "positive_class",
        "item_count",
        "normal_count",
        "anomaly_count",
        "true_positive_count",
        "false_negative_count",
        "true_negative_count",
        "false_positive_count",
        "score_failure_count",
        "image_level_auroc",
        "image_level_auprc",
        "normal_false_positive_rate",
        "anomaly_recall",
        "threshold",
        "threshold_source_path"
      ],
      "field_types": {
        "contract_version": "string",
        "run_id": "string",
        "run_kind": "string",
        "method": "string",
        "positive_class": "string",
        "item_count": "integer",
        "normal_count": "integer",
        "anomaly_count": "integer",
        "true_positive_count": "integer",
        "false_negative_count": "integer",
        "true_negative_count": "integer",
        "false_positive_count": "integer",
        "score_failure_count": "integer",
        "image_level_auroc": "number",
        "image_level_auprc": "number",
        "normal_false_positive_rate": "number",
        "anomaly_recall": "number",
        "threshold": "number",
        "threshold_source_path": "relative_path"
      },
      "additional_keys_allowed": false
    },
    "latency": {
      "format": "json_and_csv",
      "files": {
        "summary": {
          "format": "json",
          "path_template": "{method}/latency.json",
