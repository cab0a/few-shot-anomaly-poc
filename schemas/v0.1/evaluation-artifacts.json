            "contract_version",
            "run_id",
            "run_kind",
            "method",
            "measurement_boundary",
            "timer",
            "warmup_passes",
            "timed_passes",
            "item_count",
            "sample_count",
            "score_failure_timing_count",
            "score_failure_paths",
            "median_latency_ns",
            "p95_latency_ns",
            "median_latency_seconds",
            "p95_latency_seconds",
            "p95_rank",
            "environment"
          ],
          "field_types": {
            "contract_version": "string",
            "run_id": "string",
            "run_kind": "string",
            "method": "string",
            "measurement_boundary": "string",
            "timer": "string",
            "warmup_passes": "integer",
            "timed_passes": "integer",
            "item_count": "integer",
            "sample_count": "integer",
            "score_failure_timing_count": "integer",
            "score_failure_paths": "relative_path_array",
            "median_latency_ns": "number",
            "p95_latency_ns": "integer",
            "median_latency_seconds": "number",
            "p95_latency_seconds": "number",
            "p95_rank": "integer",
            "environment": "object"
          },
          "environment_required_keys": [
            "cpu_model",
            "logical_core_count",
            "physical_core_count",
            "ram_bytes",
            "operating_system",
            "machine",
            "python_version",
            "opencv_thread_count",
            "dependency_versions",
            "thread_environment"
          ],
          "environment_field_types": {
            "cpu_model": "nullable_string",
            "logical_core_count": "nullable_integer",
            "physical_core_count": "nullable_integer",
            "ram_bytes": "nullable_integer",
            "operating_system": "string",
            "machine": "string",
            "python_version": "string",
            "opencv_thread_count": "nullable_integer",
            "dependency_versions": "string_pair_array",
            "thread_environment": "nullable_string_pair_array"
          },
          "additional_keys_allowed": false
        },
        "observations": {
          "format": "csv",
          "path_template": "{method}/latency-observations.csv",
          "primary_key": [
