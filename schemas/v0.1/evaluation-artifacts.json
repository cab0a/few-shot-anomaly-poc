        "order": "integer",
        "operator": "string",
        "required_value": "number_integer_or_boolean",
        "observed_value": "number_integer_or_boolean",
        "passed": "boolean"
      },
      "additional_keys_allowed": false
    },
    "bundle_manifest": {
      "format": "json",
      "path_template": "artifact-manifest.json",
      "required_keys": [
        "contract_version",
        "run_id",
        "run_kind",
        "dataset",
        "category",
        "source_commit",
        "config_sha256",
        "partition_manifest_sha256",
        "files"
      ],
      "field_types": {
        "contract_version": "string",
        "run_id": "string",
        "run_kind": "string",
        "dataset": "string",
        "category": "string",
        "source_commit": "git_commit_sha",
        "config_sha256": "sha256",
        "partition_manifest_sha256": "sha256",
        "files": "object_array"
      },
      "file_entry_required_keys": [
        "artifact_type",
        "method",
        "relative_path",
        "sha256",
        "record_count"
      ],
      "file_entry_field_types": {
        "artifact_type": "string",
        "method": "nullable_string",
        "relative_path": "relative_path",
        "sha256": "sha256",
        "record_count": "integer"
      },
      "file_sort_key": [
