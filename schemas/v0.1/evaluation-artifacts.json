    "decision": {
      "format": "json",
      "path_template": "{method}/decision.json",
      "required_keys": [
        "contract_version",
        "run_id",
        "run_kind",
        "method",
        "decision",
        "gate_outcomes",
        "all_hard_gates_passed",
        "first_failed_gate",
        "test_leakage_detected",
        "failure_review_disposition",
        "failure_review_rationale",
        "condition",
        "decision_reason"
