            "method",
            "pass_index",
            "relative_path"
          ],
          "sort_key": [
            "method",
            "pass_index",
            "relative_path"
          ],
          "columns": [
            {
              "name": "contract_version",
              "type": "string",
              "nullable": false,
              "fixed": "evaluation-artifacts/v0.1"
            },
            {
              "name": "run_id",
              "type": "string",
              "nullable": false
            },
            {
              "name": "run_kind",
              "type": "string",
              "nullable": false
            },
            {
              "name": "method",
              "type": "string",
              "nullable": false
            },
            {
              "name": "pass_index",
              "type": "integer",
              "nullable": false
            },
            {
              "name": "relative_path",
              "type": "relative_path",
              "nullable": false
            },
            {
              "name": "duration_ns",
              "type": "integer",
              "nullable": false
            },
            {
              "name": "score_status",
              "type": "string",
